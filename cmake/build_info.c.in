// Compile-time library information

#include "liquid.h"

// const char   version[]      = "@PROJECT_VERSION@";
// unsigned int version_major  = @PROJECT_VERSION_MAJOR@;
// unsigned int version_minor  = @PROJECT_VERSION_MINOR@+0;
// unsigned int version_patch  = @PROJECT_VERSION_PATCH@+0;
// unsigned int version_tweak  = @PROJECT_VERSION_TWEAK@+0;

const struct liquid_build_info_s liquid_build_info =
{
    // library metadata
    .copyright          = "@PROJECT_COPYRIGHT@",
    .license            = "@PROJECT_LICENSE@",
    //.author             = "@PROJECT_AUTHOR@",
    //.homepage           = "@PROJECT_HOMEPAGE@",
    //.description        = "@PROJECT_DESCRIPTION@",

    // version information
    .version            = LIQUID_VERSION, // "@PROJECT_VERSION@"
    .githash            = "@BUILD_GITHASH@",

    // date/time of build
    .build_datetime     = "@BUILD_DATETIME@",
    .build_hostname     = "@BUILD_HOSTNAME@",
    .build_os           = "@CMAKE_HOST_SYSTEM_NAME@",
    .build_arch         = "@CMAKE_HOST_SYSTEM_PROCESSOR@",
    .build_toolchain    = "@CMAKE_C_COMPILER_INFO@",
    .build_type         = "@CMAKE_BUILD_TYPE@",
    .build_env          = "@BUILD_ENV@", // cmake, autotools, etc.

    // target platform
    .target_os          = "@CMAKE_SYSTEM_NAME@",
    .target_arch        = "@CMAKE_SYSTEM_PROCESSOR@",

    // other compile-time options
    .logging_enabled    = @ENABLE_LOGGING@+0,
    .logging_level      = @LIQUID_LOG_LEVEL_COMPILE@+0,
    .color_enabled      = @ENABLE_COLOR@+0,
};

